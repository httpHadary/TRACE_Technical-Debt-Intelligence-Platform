```gitignore
# Java compiled files
*.class

# Logs
*.log

# Java archives
*.jar
*.war
*.nar
*.ear

# Maven
target/
.mvn/wrapper/maven-wrapper.jar

# Java crash logs
hs_err_pid*
replay_pid*

# Spring Tool Suite / Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Gradle
.gradle/
build/

# VS Code
.vscode/

# Environment variables and secrets
.env
.env.*
!.env.example

# OS-generated files
.DS_Store
Thumbs.db
